{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "internal-docs-hybrid-rag",
	"main": "app/worker.py",
	"compatibility_date": "2026-10-09",
	"compatibility_flags": [
		"python_workers"
	],
	"assets": {
		"directory": "./frontend",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"kv_namespaces": [
		{
			"binding": "RAG_INDEX",
			"id": "96eec1fb5c6c46929830a6879a356aef",
			"remote": true
		}
	],
	"observability": {
		"enabled": true
	}
}